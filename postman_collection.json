								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.accessToken) {",
									"    pm.collectionVariables.set('token', jsonData.accessToken);",
									"    console.log('Token JWT guardado automáticamente en la colección');",
									"}"
								],
								"type": "text/javascript"
							}
						}
